# scripted (default, demo-safe) | qvac
ENGINE=scripted

# clean | degraded | hostile
NET_PROFILE=clean

# Localhost for one-laptop work. Thunderbolt demo: http://169.254.x.x:3001/api/ingest
HQ_INGEST_URL=http://127.0.0.1:3001/api/ingest

RESPONDER_PORT=3000
HQ_PORT=3001
CIVILIAN_PORT=3002
RESPONDER_ID=UNIT-7
INCIDENT_ID=INC-DEMO

# ollama (real local Meta model) | scripted (demo kill switch)
CIVILIAN_ENGINE=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b-instruct-q4_K_M
# Optional. Defaults to .cache/fieldlink-voice inside this repository.
VOICE_MODEL_CACHE=
# Optional. Defaults to Xenova/whisper-tiny.en.
WHISPER_MODEL=Xenova/whisper-tiny.en
# Set to 1 during local debugging to include full prompt and raw model JSON in terminal logs.
CIVILIAN_DEBUG=0
